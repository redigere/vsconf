    "workbench.colorTheme": "Catppuccin Mocha",
    "workbench.sideBar.location": "right",
    "workbench.startupEditor": "none",
    "workbench.tips.enabled": false,
    "workbench.editor.labelFormat": "short",
    "workbench.tree.indent": 20,
    "workbench.list.smoothScrolling": true,
    "workbench.activityBar.location": "side",
    "workbench.layoutControl.enabled": false,
    "workbench.editor.groupWithTabsHeader": "off",
    "workbench.editor.wrapTabs": false,
    "workbench.editor.scrollTabs": true,
    "workbench.editor.tabSizing": "fit",
    "workbench.editor.showTabs": "multiple",
    "workbench.editor.enablePreview": false,
    "workbench.editor.enablePreviewFromQuickOpen": false,
    "workbench.editor.scrollBeyondLastLine": false,
    "workbench.editor.limitCountPerGroup": 10,
    "workbench.editor.centeredLayout": false,
    "workbench.editor.tabHeight": 32,
    "workbench.panel.defaultLocation": "bottom",
    "workbench.panel.position": "bottom",
    "workbench.panel.autoHideDelay": 300,
    "workbench.sideBar.width": 260,
    "workbench.pinnedBanner.maxVisible": 0,

    "window.menuBarVisibility": "toggle",
    "window.titleBarStyle": "custom",
    "window.density.editorTabHeight": "compact",
    "window.title": "${dirty}${activeEditorShort}${separator}${rootName}",
    "window.commandCenter": true,

    "editor.minimap.enabled": false,
    "editor.scrollbar.verticalScrollbarSize": 8,
    "editor.scrollbar.horizontalScrollbarSize": 8,
    "editor.glyphMargin": false,
    "editor.stickyScroll.enabled": true,
    "editor.fontSize": 14,
    "editor.fontFamily": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace",
    "editor.fontLigatures": true,
    "editor.letterSpacing": 0.3,
    "editor.lineHeight": 22,
    "editor.lineNumbers": "relative",
    "editor.cursorStyle": "block",
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorWidth": 2,
    "editor.smoothScrolling": true,
    "editor.wordWrap": "on",
    "editor.formatOnSave": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.guides.indentation": true,
    "editor.renderWhitespace": "boundary",
    "editor.renderLineHighlight": "gutter",
    "editor.linkedEditing": true,
    "editor.autoClosingBrackets": "always",
    "editor.autoClosingQuotes": "always",
    "editor.autoIndent": "advanced",
    "editor.suggest.showKeywords": true,
    "editor.suggest.showSnippets": true,
    "editor.suggest.showWords": false,
    "editor.acceptSuggestionOnCommitCharacter": false,
    "editor.inlineSuggest.enabled": false,
    "editor.parameterHints.enabled": true,
    "editor.occurrencesHighlight": "singleFile",
    "editor.selectionHighlight": true,
    "editor.codeLens": false,
    "editor.folding": true,
    "editor.foldingStrategy": "indentation",
    "editor.showFoldingControls": "mouseover",
    "editor.suggestSelection": "first",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": true,
    "editor.rulers": [80, 120],
    "editor.overviewRulerBorder": false,
    "editor.overviewRulerLanes": 0,
    "editor.padding.top": 8,
    "editor.padding.bottom": 8,

    "terminal.integrated.fontFamily": "'JetBrains Mono', 'Cascadia Code Mono', monospace",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.cursorStyle": "block",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.integrated.shellIntegration.decorationsEnabled": "both",
    "terminal.integrated.suggest.enabled": false,
    "terminal.integrated.suggest.quickSuggestions": false,
    "terminal.integrated.suggest.suggestOnTriggerCharacters": false,
    "terminal.integrated.stickyScroll.enabled": true,
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.scrollback": 10000,
    "terminal.integrated.lineHeight": 1.2,
    "terminal.integrated.tabStopWidth": 4,
    "terminal.integrated.splitOnRightClick": true,
    "terminal.integrated.tabs.enabled": true,
    "terminal.integrated.tabs.hideCondition": "never",
    "terminal.integrated.tabs.location": "right",

    "explorer.openEditors.visible": 0,
    "explorer.confirmDelete": true,
    "explorer.confirmDragAndDrop": true,
    "explorer.compactFolders": false,
    "explorer.decorations.badges": true,
    "explorer.decorations.colors": true,
    "explorer.sortOrder": "type",
    "explorer.autoReveal": true,
    "explorer.enableDragAndDrop": true,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,

    "search.exclude": {
        "**/node_modules": true,
        "**/dist": true,
        "**/build": true,
        "**/.git": true,
        "**/target": true,
        "**/__pycache__": true,
        "**/.venv": true,
        "**/vendor": true,
        "**/.cargo": true
    },

    "files.autoSave": "onFocusChange",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "files.trimFinalNewlines": true,
    "files.eol": "\n",
    "files.exclude": {
        "**/.DS_Store": true,
        "**/.git": true,
        "**/.vscode": true
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/**": true,
        "**/__pycache__/**": true
    },

    "telemetry.telemetryLevel": "off",
    "telemetry.enableTelemetry": false,
    "telemetry.enableCrashReporter": false,
    "crashReporter.showTelemetryMessage": false,

    "update.mode": "none",
    "update.showReleaseNotes": false,
    "extensions.autoCheckUpdates": false,
    "extensions.autoUpdate": false,
    "extensions.ignoreRecommendations": true,
    "extensions.gallery.enabled": false,
    "extensions.showRecommendationsOnlyOnDemand": true,

    "security.workspace.trust.enabled": true,
    "security.workspace.trust.startupPrompt": "always",
    "security.workspace.trust.untrustedFiles": "newWindow",

    "git.enableSmartCommit": false,
    "git.autofetch": false,
    "git.confirmSync": true,
    "git.openRepositoryInParentFolders": "never",
    "git.terminalAuthentication": false,
    "git.decorations.enabled": true,
    "git.closeUncommittedChanges": false,
    "git.autorefresh": true,
    "git.suggestSmartCommit": false,
    "git.postCommitCommand": "none",
    "git.promptToSaveUntitledChanges": true,

    "http.proxyStrictSSL": true,

    "docker.dockerPath": "/usr/bin/podman",
    "docker.dockerComposePath": "/usr/bin/podman-compose",
    "remote.containers.defaultExtensionIds": [],
    "remote.containers.forwardPorts": [],
    "remote.containers.mountWorkspaceGit": true,

    "[json]": { "editor.defaultFormatter": "vscode.json-language-features" },
    "[jsonc]": { "editor.defaultFormatter": "vscode.json-language-features" },
    "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[scss]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[markdown]": { "editor.defaultFormatter": "yzhang.markdown-all-in-one" },
    "[python]": { "editor.defaultFormatter": "ms-python.python" },
    "[cpp]": { "editor.defaultFormatter": "ms-vscode.cpptools" },
    "[c]": { "editor.defaultFormatter": "ms-vscode.cpptools" },
    "[java]": { "editor.defaultFormatter": "redhat.java" },
    "[go]": { "editor.defaultFormatter": "golang.go", "editor.codeActionsOnSave": { "source.organizeImports": "always" } },
    "[rust]": { "editor.defaultFormatter": "rust-lang.rust-analyzer" },
    "[kotlin]": { "editor.defaultFormatter": "JetBrains.kotlin-server" },
    "[terraform]": { "editor.defaultFormatter": "hashicorp.terraform" },
    "[shellscript]": { "editor.defaultFormatter": "foxundermoon.shell-format" },
    "[yaml]": { "editor.defaultFormatter": "redhat.vscode-yaml" }
}
